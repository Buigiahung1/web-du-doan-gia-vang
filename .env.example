# ==============================================================================
# AURUM QUANT - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# Database Connection (MySQL 8.0+)
DATABASE_URL=mysql+pymysql://gold_user:SecureGoldPassword2026!@localhost:3306/gold_predict

# JWT Authentication
# Bắt buộc secret key >= 32 ký tự ngẫu nhiên
JWT_SECRET_KEY=aurum_quant_production_secret_key_2026_at_least_32_chars_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (phân tách bởi dấu phẩy, không dùng wildcard * ở prod)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:5173

# ML Inference Configuration
MODEL_DIR=ml/artifacts
DEFAULT_GOLD_TYPE=SJC_1L
USE_STUB_MODEL=false
PREDICT_TIMEOUT_S=10.0
PREDICT_RATE_LIMIT_PER_MIN=20
INFERENCE_WORKERS=2
CACHE_TTL_S=120

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@aurumquant.vn
INITIAL_ADMIN_PASSWORD=Admin@SecurePass2026!
INITIAL_ADMIN_NAME=System Administrator
