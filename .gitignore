# Local environments, dependencies and build caches
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
*.egg-info/
build/
dist/
.husky/_/

# Credentials: commit only explicit configuration examples
.env
.env.*
!.env.example
*.pem
*.key

# Runtime databases and logs (keep the shared SQL schema)
*.db
*.db-*
*.sqlite*
*.log

# Model binaries and generated training/evaluation output stay local
*.keras
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
/ml/baseline/models/
/ml/artifacts/*
!/ml/artifacts/README.md

# Historical submissions, handoff, QA and agent tooling stay on this machine
/.local-artifacts/
/archive/
/.agents/
/.codex/
/GLOSSARY.md

# Existing team policy: tests and test-only configuration are shared separately
tests/
test_*.py
/backend/requirements-dev.txt
.coverage
.coverage.*
htmlcov/
coverage/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
