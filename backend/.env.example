DATABASE_URL=mysql+pymysql://gold:gold@localhost:3306/gold_predict
CORS_ORIGINS=http://localhost:5173
MODEL_DIR=../ml/artifacts
DEFAULT_GOLD_TYPE=XAU_VND_LUONG
USE_STUB_MODEL=false
PREDICT_TIMEOUT_S=10
PREDICT_RATE_LIMIT_PER_MIN=20
INFERENCE_WORKERS=2
CACHE_TTL_S=120
# Cấu hình module của TV6 nếu wrapper dùng đường dẫn khác.
PREDICTOR_LOADER=ml.src.predict:load_predictor

# Set a random value with at least 32 characters; never commit the real secret.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
